--// Roblox Services
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

--// Remove old UI to prevent duplicates
if CoreGui:FindFirstChild("VoidHubKeySystem") then
    CoreGui.VoidHubKeySystem:Destroy()
end

--// Key System Configuration
local correctKey = "VoidHubKeyHsowjd - Gdowoh92736jsiwisHeieijdkek"
local saveFileName = "VoidHub_SavedKey.json"

--// Check if saving/loading functions exist (Executor dependent)
local function isKeySaved()
    if readfile and writefile and isfile then
        if isfile(saveFileName) then
            local success, data = pcall(function()
                return game:GetService("HttpService"):JSONDecode(readfile(saveFileName))
            end)
            if success and data and data.key == correctKey then
                -- Check if within 24 hours (86400 seconds)
                if os.time() - data.time < 86400 then
                    return true
                end
            end
        end
    end
    return false
end

local function saveKey()
    if writefile then
        local data = {
            key = correctKey,
            time = os.time()
        }
        pcall(function()
            writefile(saveFileName, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

--// Bypass key menu if valid key was saved within 24 hours
if isKeySaved() then
    loadstring(game:HttpGet("https://voidon.top/api/loader/main"))()
    return
end

