--// Get Key Event Handler
GetKeyBtn.MouseButton1Click:Connect(function()
    local getKeyLink = "https://link4m.net/kVgg2Ig"
    if setclipboard then
        setclipboard(getKeyLink)
        StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        StatusLabel.Text = "Get Key link copied to clipboard!"
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        StatusLabel.Text = "Browser does not support auto-copy!"
    end
end)

--// Check Key Event Handler
local function verifyKey()
    if TextBox.Text == correctKey then
        StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        StatusLabel.Text = "Key correct! Loading system..."
        
        -- Save key data for 24 hours
        saveKey()
        
        task.wait(0.5)
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
        TweenService:Create(Overlay, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
        task.wait(0.4)
        ScreenGui:Destroy()
        
        -- Không loadstring script chính nữa theo yêu cầu của bạn
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        StatusLabel.Text = "lopix: Incorrect password!"
        
        -- Smooth shake animation on MainFrame
        local originalPos = UDim2.new(0.5, -220, 0.5, -132)
        local shakeOffsets = {-12, 12, -8, 8, -4, 4, 0}
        
        for _, offset in ipairs(shakeOffsets) do
            TweenService:Create(MainFrame, TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Position = originalPos + UDim2.new(0, offset, 0, 0)
            }):Play()
            task.wait(0.04)
        end
        
        -- Auto-clear text when key is incorrect
        TextBox.Text = ""
    end
end

CheckKeyBtn.MouseButton1Click:Connect(verifyKey)
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verifyKey()
    end
end)
